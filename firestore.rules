rules_version = '2';

// Parcel Atlas — who may read and write the family store.
// See docs/data-model.md. The member block is written by tool/add_member.dart.
service cloud.firestore {
  match /databases/{database}/documents {

    // BEGIN MEMBERS — generated by tool/add_member.dart; do not edit by hand.
    function memberIds() { return ['eHVWWJshM0chgBdicfwxKhjNGHI2']; }
    function adminIds() { return ['eHVWWJshM0chgBdicfwxKhjNGHI2']; }
    // END MEMBERS

    function isMember() {
      return request.auth != null && request.auth.uid in memberIds();
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid in adminIds();
    }

    // A who-and-when stamp naming the caller, at the request's own time.
    function stampedNow(stamp) {
      return stamp is map
        && stamp.memberId == request.auth.uid
        && stamp.memberName is string
        && stamp.at == request.time;
    }

    function data() {
      return request.resource.data;
    }

    function keptCreated() {
      return data().created == resource.data.created;
    }

    function hasName() {
      return data().name is string && data().name.size() > 0 && data().name.size() <= 200;
    }

    // Each sign-in account's profile. Written once by the account itself
    // (through the tool), and only with the role the member list gives it.
    match /members/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.auth.uid == uid
        && data().keys().hasOnly(['name', 'username', 'role'])
        && data().role == (isAdmin() ? 'admin' : 'member');
      allow delete: if false;
    }

    // Registry parcels: read-only reference data. The only write is storing
    // what the registry answered; never deleted.
    match /officialParcels/{key} {
      allow read: if isMember();
      allow create: if isMember()
        && stampedNow(data().created)
        && stampedNow(data().refreshed);
      allow update: if isMember()
        && stampedNow(data().refreshed)
        && (keptCreated() || stampedNow(data().created));
      allow delete: if false;
    }

    // The family's drawn boundaries.
    match /drawnParcels/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && hasName()
        && data().outline is list
        && data().outline.size() >= 3
        && data().outline.size() <= 2000
        && data().owners is list
        && stampedNow(data().created)
        && stampedNow(data().updated);
      allow update: if isMember()
        && hasName()
        && data().outline is list
        && data().outline.size() >= 3
        && data().owners is list
        && keptCreated()
        && stampedNow(data().updated);
      allow delete: if isAdmin();
    }

    // Parcel owners and their groups (not sign-in accounts).
    match /persons/{id} {
      allow read: if isMember();
      allow create: if isMember() && hasName() && stampedNow(data().created) && stampedNow(data().updated);
      allow update: if isMember() && hasName() && keptCreated() && stampedNow(data().updated);
      allow delete: if isAdmin();
    }

    match /groups/{id} {
      allow read: if isMember();
      allow create: if isMember() && hasName() && data().memberIds is list
        && stampedNow(data().created) && stampedNow(data().updated);
      allow update: if isMember() && hasName() && data().memberIds is list
        && keptCreated() && stampedNow(data().updated);
      allow delete: if isAdmin();
    }

    // The change log: append-only, signed by the caller.
    match /activity/{id} {
      allow read: if isMember();
      allow create: if isMember() && stampedNow(data().by);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
